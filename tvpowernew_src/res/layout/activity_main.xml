<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101113"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="48dp">

    <!-- Left Column: Logo, Name, Status, URL, and Restart Button (Weight 1.15) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.15"
        android:orientation="vertical"
        android:paddingEnd="40dp">

        <!-- App Brand Row: Logo + App Name -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/logo"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="@string/app_name"
                android:textColor="#FFF2F1EE"
                android:textSize="36sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Status Indicator Row: Dot + Status Text -->
        <LinearLayout
            android:id="@+id/statusRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/dot" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="#FFA5A7AD"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Monospace Large URL -->
        <TextView
            android:id="@+id/tvUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFF2F1EE"
            android:textSize="30sp"
            android:fontFamily="monospace"
            android:typeface="monospace"
            android:textIsSelectable="false" />

        <!-- Restart Server Button (Single focusable control on screen) -->
        <Button
            android:id="@+id/btnRestart"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:minWidth="280dp"
            android:layout_marginTop="32dp"
            android:text="@string/restart_server"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/btn_tv_selector"
            android:textColor="@color/btn_tv_text"
            android:drawableStart="@drawable/ic_refresh"
            android:drawablePadding="12dp"
            android:paddingStart="28dp"
            android:paddingEnd="32dp"
            android:focusable="true" />
    </LinearLayout>

    <!-- Right Column: Clean White QR Code Card (Weight 1.0) -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center">

        <FrameLayout
            android:layout_width="360dp"
            android:layout_height="360dp"
            android:layout_gravity="center"
            android:background="@drawable/qr_card_bg">

            <ImageView
                android:id="@+id/ivQr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="QR code for the remote address" />

            <ImageView
                android:id="@+id/ivNoNet"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_wifi_off"
                android:visibility="gone"
                android:importantForAccessibility="no" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
