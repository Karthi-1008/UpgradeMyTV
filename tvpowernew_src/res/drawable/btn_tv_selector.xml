<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#ff272a30" />
            <stroke
                android:width="2.5dp"
                android:color="#ffff6b3d" />
            <corners android:radius="14dp" />
            <padding
                android:bottom="14dp"
                android:left="24dp"
                android:right="24dp"
                android:top="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#ffe85a2d" />
            <corners android:radius="14dp" />
            <padding
                android:bottom="14dp"
                android:left="24dp"
                android:right="24dp"
                android:top="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#ff1e2024" />
            <stroke
                android:width="1dp"
                android:color="#ff272a30" />
            <corners android:radius="14dp" />
            <padding
                android:bottom="14dp"
                android:left="24dp"
                android:right="24dp"
                android:top="14dp" />
        </shape>
    </item>
</selector>
