<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFF6B3D" />
            <stroke android:width="3dp" android:color="#66FF6B3D" />
            <corners android:radius="20dp" />
            <padding
                android:left="28dp"
                android:top="16dp"
                android:right="32dp"
                android:bottom="16dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFE85A2D" />
            <corners android:radius="20dp" />
            <padding
                android:left="28dp"
                android:top="16dp"
                android:right="32dp"
                android:bottom="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1E2024" />
            <stroke android:width="1dp" android:color="#FF272A30" />
            <corners android:radius="20dp" />
            <padding
                android:left="28dp"
                android:top="16dp"
                android:right="32dp"
                android:bottom="16dp" />
        </shape>
    </item>
</selector>
