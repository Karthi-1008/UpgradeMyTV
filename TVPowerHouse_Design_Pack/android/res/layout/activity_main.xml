<?xml version="1.0" encoding="utf-8"?>
<!-- TV home: designed on a 960x540dp canvas (1080p @ 320dpi, 720p @ 213dpi both resolve to this). Overscan-safe padding. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_stage"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="40dp"
        android:paddingBottom="40dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- LEFT: brand, status pill, URL chip, restart -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="72dp" android:layout_height="72dp"
                    android:src="@drawable/logo"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"/>
                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="38sp"
                    android:fontFamily="@font/manrope"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:includeFontPadding="false"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/statusRow"
                android:layout_width="wrap_content" android:layout_height="44dp"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/pill_status_bg"
                android:paddingStart="16dp" android:paddingEnd="20dp">
                <FrameLayout android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="-6dp">
                    <View android:id="@+id/statusRing" android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_gravity="center" android:background="@drawable/dot_ring" android:alpha="0"/>
                    <View android:id="@+id/statusDot" android:layout_width="12dp" android:layout_height="12dp"
                        android:layout_gravity="center" android:background="@drawable/dot"/>
                </FrameLayout>
                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:fontFamily="@font/manrope"
                    android:textStyle="bold"
                    android:includeFontPadding="false"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvUrl"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/url_chip_bg"
                android:paddingStart="20dp" android:paddingEnd="20dp"
                android:paddingTop="12dp" android:paddingBottom="12dp"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:fontFamily="@font/jetbrains_mono"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textIsSelectable="false"/>

            <Button
                android:id="@+id/btnRestart"
                android:layout_width="wrap_content" android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:text="@string/restart_server"
                android:textSize="20sp"
                android:fontFamily="@font/manrope"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/btn_tv_selector"
                android:textColor="@color/btn_tv_text"
                android:drawableStart="@drawable/ic_refresh"
                android:drawablePadding="12dp"
                android:paddingStart="22dp" android:paddingEnd="28dp"
                android:stateListAnimator="@null"
                android:focusable="true"
                android:nextFocusUp="@id/btnRestart" android:nextFocusDown="@id/btnRestart"
                android:nextFocusLeft="@id/btnRestart" android:nextFocusRight="@id/btnRestart"/>
        </LinearLayout>

        <!-- RIGHT: QR card -->
        <FrameLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:clipChildren="false">

            <FrameLayout
                android:id="@+id/qrCard"
                android:layout_width="324dp" android:layout_height="324dp"
                android:layout_gravity="center"
                android:padding="14dp"
                android:background="@drawable/qr_card_bg"
                android:elevation="24dp">

                <ImageView
                    android:id="@+id/ivQr"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/qr_cd"/>

                <!-- shimmer sweep, visible only in STARTING -->
                <View android:id="@+id/qrShimmer"
                    android:layout_width="120dp" android:layout_height="match_parent"
                    android:background="@drawable/shimmer_sweep" android:visibility="gone"/>

                <!-- status glyph (wifi-off / refresh) on a dark rounded tile -->
                <FrameLayout android:id="@+id/qrOverlay"
                    android:layout_width="84dp" android:layout_height="84dp"
                    android:layout_gravity="center"
                    android:background="@drawable/overlay_tile"
                    android:visibility="gone">
                    <ImageView android:id="@+id/ivNoNet"
                        android:layout_width="38dp" android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_wifi_off"
                        android:importantForAccessibility="no"/>
                </FrameLayout>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
