<?xml version="1.0" encoding="utf-8"?>
<!-- Card behind the QR: soft ring, warm-white gradient. Shadow/glow is drawn with elevation + glow ring below. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="-22dp" android:bottom="-22dp" android:left="-22dp" android:right="-22dp">
        <shape android:shape="rectangle">
            <solid android:color="#16FF6B3D"/>
            <corners android:radius="58dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FFFFFFFF" android:endColor="#FFEDEAE3"/>
            <stroke android:width="1dp" android:color="#80FFFFFF"/>
            <corners android:radius="36dp"/>
        </shape>
    </item>
</layer-list>
